<Window x:Class="SlickWatch.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SlickWatch — Your deal radar" Width="1280" Height="900" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#142F27">
      <Grid Margin="18,30,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,38"><TextBlock Text="◉  slickwatch" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="GOOD DEALS. LESS NOISE." FontSize="10" Foreground="#9ABAAF" Margin="2,9,0,0"/></StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="YOUR RADAR" Foreground="#8DA99F" FontSize="10" FontWeight="SemiBold" Margin="16,0,0,13"/>
          <Button x:Name="AllNav" Content="▦   All deals" Tag="all" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
          <Button x:Name="MatchesNav" Content="↗   Matches" Tag="matches" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
          <Button x:Name="SavedNav" Content="☆   Saved deals" Tag="saved" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
          <Button x:Name="AlertsNav" Content="◷   Alert history" Tag="alerts" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
          <Border Height="1" Background="#365047" Margin="14,22"/>
          <Button Content="⚙   Preferences" Click="Settings_Click" Style="{StaticResource NavButton}"/>
        </StackPanel>
        <Border Grid.Row="3" Background="#213F34" CornerRadius="12" Padding="16">
          <StackPanel><TextBlock Text="A little background magic." Foreground="#DCE8E1" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Close this window and your radar keeps running in the tray." Foreground="#A3BDB1" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,14"/><Button x:Name="PauseButton" Content="Pause watching" Click="Pause_Click" Padding="10,8" Background="#36594A" Foreground="White" BorderThickness="0"/></StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,28,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel><TextBlock Text="THE COMMUNITY FINDS IT. YOU CATCH IT." FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="Your deal radar" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="PageSubtitle" Text="Fresh finds from Slickdeals, with the signal turned up." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><Button Content="Test alert" Click="TestAlert_Click" Margin="0,0,9,0"/><Button x:Name="RefreshButton" Content="↻  Refresh" Click="Refresh_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,24,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="#E2E7E0" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,12,0"><StackPanel><TextBlock Text="ON YOUR RADAR" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="DealsCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,3"/><TextBlock Text="Frontpage + Popular" x:Name="SourceSummary" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
        <Border Grid.Column="1" Background="#E6F0E7" CornerRadius="12" Padding="18,14" Margin="0,0,12,0"><StackPanel><TextBlock Text="MATCHING YOUR RULES" Foreground="#4E7660" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="MatchCount" Text="0" FontSize="28" Foreground="#216851" FontWeight="SemiBold" Margin="0,3"/><TextBlock x:Name="RuleSummary" Text="More than 30 thumbs OR 50 comments" Foreground="#4E7660" FontSize="12"/></StackPanel></Border>
        <Border Grid.Column="2" Background="White" BorderBrush="#E2E7E0" BorderThickness="1" CornerRadius="12" Padding="18,14"><StackPanel><TextBlock Text="WATCH STATUS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="WatchStatus" Text="●  Starting" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,6"/><TextBlock x:Name="NextCheck" Text="First scan loads quietly" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
      </Grid>
      <Border Grid.Row="2" x:Name="ErrorBanner" Visibility="Collapsed" Background="#FFF0D6" CornerRadius="8" Padding="12" Margin="0,0,0,14"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#77541A" FontSize="12"/></Border>
      <Grid Grid.Row="3" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,12,0"><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" ToolTip="Search deal titles, descriptions and categories" AutomationProperties.Name="Search deals"/><TextBlock Text="Search your deals…" Foreground="#8A958F" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <ComboBox Grid.Column="1" x:Name="SourceFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,12,0" AutomationProperties.Name="Feed filter"><ComboBoxItem Content="All feeds"/><ComboBoxItem Content="Frontpage"/><ComboBoxItem Content="Popular"/></ComboBox>
        <ComboBox Grid.Column="2" x:Name="SortBox" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Sort deals"><ComboBoxItem Content="Highest score"/><ComboBoxItem Content="Most discussed"/><ComboBoxItem Content="Newest posted"/><ComboBoxItem Content="Recently found"/></ComboBox>
      </Grid>
      <DockPanel Grid.Row="4" Margin="1,0,0,12"><TextBlock x:Name="ResultsLabel" Text="Loading your radar…" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="Rank is based on displayed deals" FontSize="11" Foreground="#8A958F" HorizontalAlignment="Right"/></DockPanel>
      <Grid Grid.Row="5">
        <ScrollViewer x:Name="DealsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="DealsScroll_SizeChanged">
          <StackPanel>
          <ItemsControl x:Name="DealItems">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,14,16" Background="White" BorderBrush="#DEE5DE" BorderThickness="1" CornerRadius="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border Background="#EEF1ED" CornerRadius="12,12,0,0"><Grid><TextBlock Text="◇" Foreground="#BCC9BE" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ImageUrl}" Stretch="Uniform" Margin="14" ImageFailed="Image_Failed"/><Border Background="#EFFFF5" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="7,4"><TextBlock Text="{Binding StatusLabel}" FontSize="9" Foreground="#2F6551" FontWeight="SemiBold"/></Border><Border Background="White" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="7,4" ToolTip="Rank in the current view"><TextBlock Text="{Binding RankLabel}" FontSize="10" Foreground="#576D5D" FontWeight="SemiBold"/></Border></Grid></Border>
                  <StackPanel Grid.Row="1" Margin="16,14,16,16">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Height="44" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Height="34" TextTrimming="CharacterEllipsis" Margin="0,8,0,12"/>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding MetricsTooltip}"><Border Background="#E8F1E9" CornerRadius="5" Padding="8,5"><TextBlock Foreground="#236447" FontWeight="SemiBold" FontSize="12"><Run Text="↑ "/><Run Text="{Binding ScoreLabel, Mode=OneWay}"/><Run Text=" thumbs"/></TextBlock></Border><Border Background="#F1F3F0" CornerRadius="5" Padding="8,5" Margin="7,0,0,0"><TextBlock FontSize="12" Foreground="#5F6D65"><Run Text="{Binding CommentsLabel, Mode=OneWay}"/><Run Text=" comments"/></TextBlock></Border></StackPanel>
                    <TextBlock Foreground="#839087" FontSize="10" Margin="0,11,0,12"><Run Text="{Binding DateKind, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DateLabel, Mode=OneWay}"/></TextBlock>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="View deal  ↗" Click="OpenDeal_Click" Tag="{Binding}" Padding="10,8" HorizontalAlignment="Left" BorderThickness="0" Background="#F0F5EE" Foreground="#216851" FontSize="12"/><Button Grid.Column="1" Content="{Binding SaveLabel}" Tag="{Binding}" Click="SaveDeal_Click" Padding="9,8" BorderThickness="0" FontSize="12"/></Grid>
                    <Button Content="Read description" Click="Details_Click" Tag="{Binding}" FontSize="10" Padding="4,5" BorderThickness="0" Foreground="#78867D" HorizontalAlignment="Left" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="LoadMoreButton" Content="Show 60 more deals" Click="LoadMore_Click" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,16"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AlertsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AlertItems"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,10" BorderBrush="#DEE5DE" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" Foreground="#216851" Margin="0,7,0,5"/><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MMM d · h:mm tt}}" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><Button Grid.Column="1" Content="Open ↗" Click="OpenAlert_Click" Tag="{Binding}" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◎" FontSize="58" Foreground="#8EAF99" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="Tuning in to your next find" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,13,0,8"/><TextBlock x:Name="EmptyDescription" Text="Your feeds will appear here after the first check." Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="450"/></StackPanel>
      </Grid>
      <DockPanel Grid.Row="6" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="Connecting to Slickdeals…" Foreground="#76857C" FontSize="11"/><TextBlock Text="Unofficial Slickdeals reader" Foreground="#93A096" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
    </Grid>
  </Grid>
</Window>
